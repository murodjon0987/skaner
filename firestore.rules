rules_version = '2';

// =============================================================
// ScanPOS – Firestore Security Rules
// =============================================================
// - Har bir user faqat o'z `users/{uid}` ostidagi ma'lumotlarini boshqaradi.
// - Admin (ADMIN_EMAIL) barcha userlarni va to'lov so'rovlarini boshqaradi.
// - notifications: user o'qiydi va faqat "read" ni belgilaydi;
//   yaratish/o'chirish faqat admin.
//
// Joylashtirish: firebase deploy --only firestore:rules
// (yoki Firebase Console → Firestore → Rules)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin emaillar (app.js dagi ADMIN_EMAILS bilan bir xil bo'lishi kerak)
    function isAdminByEmail() {
      return isSignedIn() && (
        request.auth.token.email == 'syodgorov47@gmail.com' ||
        request.auth.token.email == 'wenzonepeser@gmail.com'
      );
    }

    // Admin: email YOKI `admins/{uid}` allowlist hujjati mavjud
    function isAdmin() {
      return isAdminByEmail() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function ownerOrAdmin(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Admin allowlist hujjatlari
    // - Admin email o'zi uchun yozo oladi
    // - Yoki maxfiy kod bilan ("wenzone") o'zini admin qilib qo'sha oladi
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
        && (isAdminByEmail() || request.resource.data.code == 'wenzone');
      allow update: if isAdmin() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Obuna uchun to'lov so'rovlari (manual to'lov)
    match /paymentRequests/{reqId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Foydalanuvchi profili va sub-kolleksiyalari
    match /users/{userId} {
      allow read, write: if ownerOrAdmin(userId);

      // Ma'lumot sub-kolleksiyalari (owner yoki admin)
      match /products/{docId} { allow read, write: if ownerOrAdmin(userId); }
      match /bills/{docId} { allow read, write: if ownerOrAdmin(userId); }
      match /debtors/{docId} { allow read, write: if ownerOrAdmin(userId); }
      match /debts/{docId} { allow read, write: if ownerOrAdmin(userId); }
      match /expenses/{docId} { allow read, write: if ownerOrAdmin(userId); }
      match /supplies/{docId} { allow read, write: if ownerOrAdmin(userId); }
      match /quickItems/{docId} { allow read, write: if ownerOrAdmin(userId); }
      match /heldCarts/{docId} { allow read, write: if ownerOrAdmin(userId); }
      match /meta/{docId} { allow read, write: if ownerOrAdmin(userId); }

      // Xabarnomalar: user o'qiydi va "read" ni belgilaydi; yaratish faqat admin
      match /notifications/{notifId} {
        allow read: if ownerOrAdmin(userId);
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          || (isSignedIn() && request.auth.uid == userId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      }
    }

    // Boshqa barcha yo'llar yopiq
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
